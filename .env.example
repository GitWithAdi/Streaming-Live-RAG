# Streaming Live RAG Environment Configuration

# Dense Retrieval Model (defaults to local HuggingFace / SentenceTransformers model)
DENSE_MODEL_NAME=all-MiniLM-L6-v2

# Controller Thresholds
STABILITY_CONFIDENCE_THRESHOLD=0.65
MIN_ENTITIES_FOR_PROVISIONAL=2
SUPPRESSION_CONFIDENCE_THRESHOLD=0.75

# Hybrid Search RRF Constant
RRF_K=60
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# Paths
CORPUS_DIRECTORY=data/corpus
BENCHMARK_DIRECTORY=data/benchmarks
